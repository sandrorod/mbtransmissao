{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "electron/**/*",
    "src/types/**/*",
    "src/devices/avfoundation.ts",
    "src/devices/identify.ts",
    "src/utils/validate.ts",
    "electron.vite.config.ts"
  ]
}